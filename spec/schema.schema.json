{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "loomhelix-cms schema, format version 0",
  "type": "object",
  "required": ["formatVersion", "pages", "blocks"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 0 },
    "pages": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/type" }
    },
    "blocks": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/type" }
    },
    "removedTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
    "optionName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$" },
    "option": {
      "oneOf": [
        { "$ref": "#/$defs/optionName" },
        {
          "type": "object",
          "required": ["name", "label"],
          "additionalProperties": false,
          "properties": {
            "name": { "$ref": "#/$defs/optionName" },
            "label": { "type": "string" }
          }
        }
      ]
    },
    "type": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "label": { "type": "string" },
        "fields": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "slots": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "$ref": "#/$defs/slot" }
        },
        "migrations": {
          "type": "array",
          "items": { "$ref": "#/$defs/migration" }
        },
        "oldNames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["text", "richText", "link", "image", "choice", "number", "boolean", "record"]
        },
        "label": { "type": "string" },
        "optional": { "type": "boolean" },
        "default": true
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "number" } } },
          "then": {
            "properties": {
              "integer": { "type": "boolean" },
              "min": { "type": "number" },
              "max": { "type": "number" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": {
            "properties": {
              "multiline": { "type": "boolean" },
              "maxLength": { "type": "integer", "minimum": 1 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "record" } } },
          "then": {
            "required": ["source"],
            "properties": {
              "source": { "$ref": "#/$defs/optionName" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "choice" } } },
          "then": {
            "required": ["options"],
            "properties": {
              "options": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/option" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "slot": {
      "type": "object",
      "required": ["allow"],
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/name" }
        },
        "label": { "type": "string" },
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 }
      }
    },
    "migration": {
      "type": "object",
      "required": ["from", "operations"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "integer", "minimum": 1 },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    },
    "operation": {
      "oneOf": [
        { "$ref": "#/$defs/renameField" },
        { "$ref": "#/$defs/addField" },
        { "$ref": "#/$defs/removeField" },
        { "$ref": "#/$defs/mapValues" },
        { "$ref": "#/$defs/renameSlot" },
        { "$ref": "#/$defs/removeSlot" }
      ]
    },
    "renameField": {
      "type": "object",
      "required": ["op", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "renameField" },
        "from": { "$ref": "#/$defs/name" },
        "to": { "$ref": "#/$defs/name" }
      }
    },
    "addField": {
      "type": "object",
      "required": ["op", "field", "value"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "addField" },
        "field": { "$ref": "#/$defs/name" },
        "value": true
      }
    },
    "removeField": {
      "type": "object",
      "required": ["op", "field"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "removeField" },
        "field": { "$ref": "#/$defs/name" }
      }
    },
    "mapValues": {
      "type": "object",
      "required": ["op", "field", "values"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "mapValues" },
        "field": { "$ref": "#/$defs/name" },
        "values": { "type": "object" }
      }
    },
    "renameSlot": {
      "type": "object",
      "required": ["op", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "renameSlot" },
        "from": { "$ref": "#/$defs/name" },
        "to": { "$ref": "#/$defs/name" }
      }
    },
    "removeSlot": {
      "type": "object",
      "required": ["op", "slot"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "removeSlot" },
        "slot": { "$ref": "#/$defs/name" }
      }
    }
  }
}
