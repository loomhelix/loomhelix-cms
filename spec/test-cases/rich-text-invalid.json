{
  "description": "Formatted text rejects each value that breaks a rule of section 3.3",
  "schema": {
    "formatVersion": 0,
    "pages": {
      "Landing": {
        "version": 1,
        "slots": {
          "main": {
            "allow": ["Text"]
          }
        }
      }
    },
    "blocks": {
      "Text": {
        "version": 1,
        "fields": {
          "body": {
            "type": "richText"
          }
        }
      }
    }
  },
  "document": {
