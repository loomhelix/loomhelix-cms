{
  "description": "A rename fails if the new field has a value already",
  "schema": {
    "formatVersion": 0,
    "pages": {
      "Landing": {
        "version": 1,
        "slots": {
          "main": {
            "allow": ["Text"]
          }
        }
      }
    },
    "blocks": {
      "Text": {
        "version": 2,
        "fields": {
          "body": {
            "type": "text"
          }
        },
        "migrations": [
          {
            "from": 1,
            "operations": [
              {
                "op": "renameField",
                "from": "heading",
                "to": "body"
              }
            ]
          }
        ]
      }
    }
  },
  "document": {
    "formatVersion": 0,
    "root": {
      "id": "p1",
      "type": "Landing",
      "version": 1,
      "props": {
        "title": "Home",
        "path": "/"
      },
      "slots": {
        "main": [
          {
            "id": "b1",
            "type": "Text",
            "version": 1,
            "props": {
              "heading": "Hello",
              "body": "Hi"
            }
          }
        ]
      }
    }
  },
  "expected": {
    "errors": [
      {
        "blockId": "b1",
        "code": "migrationFailed"
      }
    ]
  }
}
