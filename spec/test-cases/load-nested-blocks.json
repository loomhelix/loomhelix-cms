{
  "description": "A document with blocks in nested slots loads without errors",
  "schema": {
    "formatVersion": 0,
    "pages": {
      "Landing": {
        "version": 1,
        "slots": {
          "main": {
            "allow": ["Text", "Columns"]
          }
        }
      }
    },
    "blocks": {
      "Text": {
        "version": 1,
        "fields": {
          "body": {
            "type": "text"
          }
        }
      },
      "Columns": {
        "version": 1,
        "slots": {
          "items": {
            "allow": ["Column"]
          }
        }
      },
      "Column": {
        "version": 1,
        "slots": {
          "content": {
            "allow": ["Text"]
          }
        }
      }
    }
  },
  "document": {
    "formatVersion": 0,
    "root": {
      "id": "p1",
      "type": "Landing",
      "version": 1,
      "props": {
        "title": "Menu",
        "description": "Coffee, tea, and cakes",
        "path": "/menu/coffee"
      },
      "slots": {
        "main": [
          {
            "id": "b1",
            "type": "Text",
            "version": 1,
            "props": {
              "body": "Hello"
            }
          },
          {
            "id": "b2",
            "type": "Columns",
            "version": 1,
            "props": {},
            "slots": {
              "items": [
                {
                  "id": "b3",
                  "type": "Column",
                  "version": 1,
                  "props": {},
                  "slots": {
                    "content": [
                      {
                        "id": "b4",
                        "type": "Text",
                        "version": 1,
                        "props": {
                          "body": "Hello"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "expected": {
    "errors": []
  }
}
