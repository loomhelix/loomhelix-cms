{
  "description": "A root block of a type that the schema does not define is invalid",
  "schema": {
    "formatVersion": 0,
    "pages": {
      "Landing": {
        "version": 1,
        "slots": {
          "main": {
            "allow": ["Text", "Columns"]
          }
        }
      }
    },
    "blocks": {
      "Text": {
        "version": 1,
        "fields": {
          "body": {
            "type": "text"
          }
        }
      },
      "Columns": {
        "version": 1,
        "slots": {
          "items": {
            "allow": ["Column"]
          }
        }
      },
      "Column": {
        "version": 1,
        "slots": {
          "content": {
            "allow": ["Text"]
          }
        }
      }
    }
  },
  "document": {
    "formatVersion": 0,
    "root": {
      "id": "p1",
      "type": "Gallery",
