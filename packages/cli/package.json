{
  "name": "@loomhelix-cms/cli",
  "version": "0.1.0",
  "private": true,
  "description": "The lhcms command: build blocks.json from blocks.ts, write the types of the templates, and print a first template.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loomhelix/loomhelix-cms.git",
    "directory": "packages/cli"
  },
  "bin": {
    "lhcms": "./src/bin.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
